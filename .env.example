NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# New Supabase publishable key format (or legacy NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sbp_your-publishable-key-here

# Server-only secret key for calendar subscribe feed (never expose to the browser)
# Prefer SUPABASE_SECRET_KEY; SUPABASE_SERVICE_ROLE_KEY also works
SUPABASE_SECRET_KEY=your-secret-key-here
